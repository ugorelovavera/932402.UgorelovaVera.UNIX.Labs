#!/bin/sh
N="${1:-1}"
T="${2:-10}"
IMAGE="workerlab2"
VOLUME="volumeLab2"
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
echo "TEST N=$N T=${T}s"
echo "1) cleaning log and files"
docker run --rm -v "$VOLUME:/shared" alpine sh -c '
    rm -f /shared/.log /shared/.log.prev
    find /shared -maxdepth 1 -type f -name "[0-9][0-9][0-9]" -delete
' >/dev/null
echo "2) starting $N containers"
i=1
while [ "$i" -le "$N" ]; do
    docker run -d --rm -v "$VOLUME:/shared" -e "CONTAINER_ID=c$i" "$IMAGE" >/dev/null
    i=$((i + 1))
done
echo "3) running ${T}s"
sleep "$T"

echo "4) validating log"
sh "$SCRIPT_DIR/check"
echo "5) stopping containers"
docker stop $(docker ps -q --filter ancestor="$IMAGE") >/dev/null 2>&1
sleep 2
echo "6) cleaning files (log kept)"
docker run --rm -v "$VOLUME:/shared" alpine sh -c '
    find /shared -maxdepth 1 -type f -name "[0-9][0-9][0-9]" -delete
' >/dev/null
echo "DONE. LOG KEPT AT /shared/.log"